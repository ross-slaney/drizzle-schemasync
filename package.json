{
  "name": "drizzle-schemasync",
  "version": "0.1.1",
  "description": "Your Drizzle schema is your SQLite database. Diff it against the live database and apply the difference, on the device, with no migration files.",
  "license": "MIT",
  "author": "Ross Slaney",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ross-slaney/drizzle-schemasync.git"
  },
  "homepage": "https://github.com/ross-slaney/drizzle-schemasync#readme",
  "bugs": "https://github.com/ross-slaney/drizzle-schemasync/issues",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "sqlite",
    "expo-sqlite",
    "schema",
    "migrations",
    "declarative",
    "offline-first",
    "react-native"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/moving-from-drizzle-migrations.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run coverage && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sql.js": "^1.4.9",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "sql.js": "^1.14.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
